# Normalize all text files to LF
* text=auto eol=lf

# Ensure patch files always use LF line endings
*.patch text eol=lf

# cmd.exe mis-seeks after goto/call :label in LF-only batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Runtime binaries and textures must not be line-ending converted
*.dll binary
*.dds binary
*.png binary
*.nif binary
*.esp binary
*.pdb binary
*.exe binary
